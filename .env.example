# Browser API endpoints. These are required for live market data.
NEXT_PUBLIC_MARKET_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MARKET_WS_URL=ws://localhost:8000/ws/market

# Backend runtime
GMI_ENVIRONMENT=development
GMI_ALPHA_VANTAGE_API_KEY=
GMI_ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
GMI_ALPHA_VANTAGE_CACHE_TTL_SECONDS=21600
GMI_ALPHA_VANTAGE_DAILY_REQUEST_LIMIT=25
GMI_ALPHA_VANTAGE_TIMEOUT_SECONDS=12
GMI_ALPHA_VANTAGE_MIN_REQUEST_INTERVAL_SECONDS=1.1
GMI_ALPHA_VANTAGE_INTRADAY_ENABLED=false
GMI_RANDOM_SEED=17
GMI_SIMULATION_INTERVAL_SECONDS=1.0
GMI_HISTORY_LIMIT=500
GMI_REDIS_URL=redis://localhost:6379/0
GMI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

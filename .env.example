# Browser API endpoints. Leave both empty to use the deterministic UI simulator.
NEXT_PUBLIC_MARKET_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MARKET_WS_URL=ws://localhost:8000/ws/market

# Backend runtime
GMI_ENVIRONMENT=development
GMI_RANDOM_SEED=17
GMI_SIMULATION_INTERVAL_SECONDS=1.0
GMI_HISTORY_LIMIT=500
GMI_REDIS_URL=redis://localhost:6379/0
GMI_CORS_ORIGINS=http://localhost:3000
